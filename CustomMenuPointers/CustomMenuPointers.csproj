<Project>
  <Import Project="Sdk.props" Sdk="Microsoft.NET.Sdk" />
  <PropertyGroup>
    <GameDirectory Condition="'$(GameDirectory)' == '' AND '$(BeatSaberDir)' != ''">$(BeatSaberDir)</GameDirectory>
    <BeatSaberDir>$(GameDirectory)</BeatSaberDir>
    <TargetFramework>net472</TargetFramework>
    <OutputType>Library</OutputType>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <AppOutputBase>$(MSBuildProjectDirectory)\</AppOutputBase>
    <DebugType>portable</DebugType>
    <DisableCopyToPlugins>True</DisableCopyToPlugins>
  </PropertyGroup>
  <PropertyGroup Condition="'$(NCrunch)' == '1'">
    <DisableZipRelease>True</DisableZipRelease>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="BeatSaber.ViewSystem" Private="false" />
    <Reference Include="DataModels" Private="false" />
    <Reference Include="Main" Private="false" />
    <Reference Include="Colors" Private="false" />
    <Reference Include="GameplayCore" Private="false" />
    <Reference Include="HMLib" Private="false" />
    <Reference Include="HMUI" Private="false" />
    <Reference Include="SaberTrail" Private="false" />
    <Reference Include="IPA.Loader" Private="false" />
    <Reference Include="BSML" Private="false" />
    <Reference Include="SiraUtil" Private="false" />
    <Reference Include="SabersCore" Private="false" />
    <Reference Include="CustomSabersLite" Private="false" />
    <Reference Include="UnityEngine.CoreModule" Private="false" />
    <Reference Include="UnityEngine.PhysicsModule" Private="false" />
    <Reference Include="Zenject" Private="false" />
    <Reference Include="Zenject-usage" Private="false" />
  </ItemGroup>
  <ItemGroup>
    <None Include="Directory.Build.props" Condition="Exists('Directory.Build.props')" />
    <None Include="Directory.Build.targets" Condition="Exists('Directory.Build.targets')" />
    <None Include="CustomMenuPointers.csproj.user" Condition="Exists('CustomMenuPointers.csproj.user')" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="manifest.json" />
    <EmbeddedResource Include="UI\*.bsml" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="BeatSaberModdingTools.Tasks" Version="1.4.3">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>
  <Import Project="Sdk.targets" Sdk="Microsoft.NET.Sdk" />
  <Import Project="BSIPA.Layout.targets" Condition="Exists('$(GameDirectory)\IPA\Data\Managed\IPA.Loader.dll')" />
</Project>
